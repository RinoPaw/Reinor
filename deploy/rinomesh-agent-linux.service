[Unit]
Description=Reinor Linux Agent (enrolled device)
After=network-online.target rinomesh-gateway.service
Wants=network-online.target rinomesh-gateway.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/opt/rinomesh-control/bin/rinomesh-agent-linux join --gateway https://xuhuaai.top --device rino-tx
Restart=always
RestartSec=8

[Install]
WantedBy=multi-user.target
